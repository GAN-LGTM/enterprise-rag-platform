# ============================================================
# 生产配置模板（不含真实密钥，交付时由 deploy/init_env.py 生成 .env.production）
# 复制本文件为 .env.production 后填写，或直接运行：
#     python deploy/init_env.py --origins https://rag.客户域名.com
# ============================================================
ENVIRONMENT=production
DEMO_MODE=false
APP_NAME=企业级知识检索中台
APP_VERSION=1.2.1
OFFLINE_MODE=true

# 公网搜索总开关（必应/搜狗/天气等所有出公网工具）。
# 合规零外网场景保持 false（OFFLINE_MODE=true 时默认即关闭，可不写本行）；
# 确需联网问答（如"最近金价/演唱会"）时设 true，且理解将产生外网请求。
# 注意：即便开启，出网前也会脱敏，绝不携带内网文档/部门名/人名/用户身份。
PUBLIC_SEARCH_ENABLED=false

# ---------------- 安全 ----------------
# 必改：随机 48 位以上；泄露等于可伪造任意身份
JWT_SECRET_KEY=<由 init_env.py 生成>
JWT_EXPIRE_MINUTES=60
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true
# 前端来源白名单，禁止 "*"
ALLOWED_ORIGINS=https://rag.corp.example.com

# 初始管理员（首次登录强制改密）
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=<由 init_env.py 生成>
ADMIN_FORCE_PASSWORD_CHANGE=true

# ---------------- 数据库 / 缓存 ----------------
PG_USER=rag
PG_PASSWORD=<强口令>
PG_DB=ragdb
DB_FORCE_MEMORY=false
DB_AUTO_FALLBACK=false
REDIS_ENABLED=true
REDIS_MAXMEMORY=2gb
# Redis 口令（compose 用它做 requirepass；内部网络同样要求认证）
REDIS_PASSWORD=<由 init_env.py 生成>

# ---------------- 模型（私有化本地推理）----------------
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=/data/models/bge-large-zh-v1.5
EMBEDDING_DIM=1024

LLM_BACKEND=vllm
LLM_MODEL=qwen-14b-chat
LLM_BASE_URL=http://vllm:8000/v1
LLM_FALLBACK_MODEL=qwen-7b-chat
ALLOW_CLOUD_LLM=false

BERT_ENABLED=false
BERT_MODEL_PATH=/data/models/bert-tiny/intent.onnx

# ---------------- 运行 ----------------
LOG_LEVEL=INFO
LOG_DIR=/data/logs
# 问答限流（按 user_id 滑动窗口，避免 NAT 出口 IP 误伤整个公司）
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_WINDOW_SECONDS=60
# 必须与 deploy/nginx.conf 的 client_max_body_size 一致（当前 50m）
MAX_UPLOAD_MB=50
SENSITIVE_WORDS=密码明文,root密码,数据库口令,内网拓扑,VPN账号,跳板机密码
WEB_CONCURRENCY=2
HTTP_PORT=80
HTTPS_PORT=443
MODEL_DIR=/data/models

# ---------------- 数据目录（必须与 docker-compose.prod.yml 的卷挂载点一一对应）----------------
# 不一致的后果：数据写进容器可写层，容器重建/升级后上传文档、日志、会话全部丢失。
APP_DATA_DIR=/data/app
DOC_UPLOAD_DIR=/data/docs
BACKUP_DIR=/data/backups
BACKUP_KEEP=14
