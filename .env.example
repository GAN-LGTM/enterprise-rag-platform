# ============================================================
# 私有化生产配置模板（复制为 .env 后按客户环境修改）
# ============================================================

# ---- 基础 ----
APP_NAME=企业级知识检索中台
DEBUG=false
OFFLINE_MODE=true          # 私有化：启动后零外网流量

# 公网搜索总开关（必应/搜狗/天气等所有出公网工具），合规零外网场景保持关闭（默认即关）：
#   需要让用户问"最近有什么演唱会/金价"这类联网问题时，设 true 开启；
#   开启后出网前会自动脱敏（剔除部门名/人名/内部术语），绝不携带内网上下文。
PUBLIC_SEARCH_ENABLED=false

# 财经实时工具的独立开关（A股行情 / 指数 / 板块涨跌榜 / 汇率）。
# 双开关语义：总开关 PUBLIC_SEARCH_ENABLED 关闭 → 行情必然关闭（合规优先）；
#             总开关开启后，本开关可单独把行情关掉（例如客户不想在内部系统里问股票）。
REALTIME_MARKET_ENABLED=true

# 参考类实时工具开关（百科词条 / 中国节假日）。同样是双开关，可单独关掉。
REFERENCE_TOOLS_ENABLED=true

# ---- 结构化搜索 API（可选，强烈推荐）----
# 不配（默认）：联网问答走内置的必应/搜狗网页抓取，虽已过滤导航站/词典页，
#              但抓回来的仍是网页正文，质量天然不如接口。
# 配了之后  ：直接向搜索 API 要结构化 JSON（title/snippet/url），这才是
#              豆包/DeepSeek 联网问答的做法 —— 干净、快、不会被脏页面稀释上下文。
#   tavily —— 面向 LLM 设计的搜索 API，还会额外返回一段可直接用的检索摘要（推荐）
#   serper —— Google 结果的结构化封装
# 留空则自动回退到网页抓取，功能不受影响。
SEARCH_API_PROVIDER=            # tavily | serper | 留空
SEARCH_API_KEY=

# ---- 安全（生产必须修改！）----
JWT_SECRET_KEY=<请用 openssl rand -hex 32 生成>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_MINUTES=15

# 首次登录强制改密（需求书 FR-AUTH-01）
# true  = 种子账号首次登录必须修改初始密码后才能使用系统（生产交付建议 true）
# false = 演示环境可关闭，避免阻塞体验
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true

# 敏感词拦截（需求书 NFR-SEC-07）：命中后返回友好提示，不进入检索
# 逗号分隔；删除该项/留空则不启用
SENSITIVE_WORDS=密码明文,root密码,数据库口令,数据库密码,内网拓扑,VPN账号,跳板机密码

# ---- PostgreSQL + pgvector ----
DATABASE_URL=postgresql+psycopg://rag:<密码>@postgres:5432/ragdb
DB_AUTO_FALLBACK=false     # 生产建议关闭降级，问题要暴露而不是被掩盖
DB_POOL_SIZE=20

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_AUTO_FALLBACK=true

# ---- Embedding：本地 BGE-large-zh-v1.5 ----
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=/data/models/bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ---- LLM：本地 vLLM + Qwen（生产）。本地演示可改 LLM_BACKEND=cloud 走云端免密钥模型 ----
LLM_BACKEND=vllm
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=qwen-14b-chat
LLM_FALLBACK_MODEL=qwen-7b-chat
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=3.0        # 首字超时切备选（cloud 后端建议 30）
LLM_CIRCUIT_FAIL_THRESHOLD=3
LLM_CIRCUIT_RECOVER_SECONDS=30

# ---- 云端 LLM（LLM_BACKEND=cloud 时生效；密钥由服务端持有，不下发前端）----
CLOUD_LLM_ENDPOINT=https://your-app.app.workbuddy.host
CLOUD_LLM_PUBLISHABLE_KEY=wbpk_xxx
CLOUD_LLM_MODEL=auto

# ---- 意图识别小模型 L3（需求书 FR-CHAT-02）----
# BERT_ENABLED=false 时自动回退关键词打分器，全链路照常跑通（离线 / 无模型环境安全）
# 生产：置 true 并给出 BERT-tiny 导出的 ONNX 模型路径
BERT_ENABLED=false
BERT_MODEL_PATH=/data/models/bert-tiny/intent.onnx
BERT_LABELS=chitchat,public_kb,dept_kb,cross_dept,data_analysis,operation

# ---- 检索 ----
TOP_K_VECTOR=10
TOP_K_FTS=10
TOP_K_FINAL=5
RRF_K=60
VECTOR_TIMEOUT_MS=1500

# ---- 文档 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_UPLOAD_MB=50
OCR_ENABLED=false              # 扫描件识别需部署 PaddleOCR
DOC_UPLOAD_DIR=/data/docs

# ---- 问答限流（按 user_id 滑动窗口，避免 NAT 出口 IP 误伤整个公司）----
RATE_LIMIT_PER_MIN=20              # 每用户每分钟问答次数（0 = 关闭限流）
RATE_LIMIT_WINDOW_SECONDS=60       # 滑动窗口宽度

# ---- 钉钉「请假 / 报销」审批集成 ----
# DINGTALK_MOCK=true 时无需任何凭证即可演示完整审批链路（本地模拟钉钉回调）
# 生产：DINGTALK_MOCK=false + DINGTALK_ENABLED=true 并填好凭证与模板 processCode
DINGTALK_MOCK=true
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_LEAVE_PROCESS_CODE=        # 钉钉 OA 审批「请假」模板 processCode
DINGTALK_REIMBURSE_PROCESS_CODE=    # 钉钉 OA 审批「报销」模板 processCode

# ---- 数据落盘目录（可选）----
# 覆盖反馈 / 版本 / 跨部门授权等 JSON 的落盘目录；容器部署建议挂到持久卷
# APP_DATA_DIR=/data/rag

# ---- 可观测性 ----
LOG_LEVEL=INFO
LOG_DIR=/data/logs
METRICS_ENABLED=true
